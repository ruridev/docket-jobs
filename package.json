{
  "name": "docket-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Manage the background jobs that start with your PC, in one place.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node agent/index.js",
    "dev": "node agent/index.js --no-autorun",
    "test": "node --test \"test/*.test.js\"",
    "autostart:on": "node scripts/autostart.js on",
    "autostart:off": "node scripts/autostart.js off",
    "autostart:status": "node scripts/autostart.js status"
  }
}
